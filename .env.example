# 复制为 .env 后填写。全部留空则走模板兜底（离线演示模式），流程不中断。
# Copy to .env and fill in. Leave everything empty to run in offline template mode.

# 大模型网关（OpenAI 兼容 / OpenAI-compatible）
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL="glm-4-flash"

# 语音转写 STT
# auto = 自动检测：配置了 STT_BASE_URL + STT_API_KEY 用云端，否则用浏览器内置识别
# browser = 强制浏览器识别（零配置）
# openai-compatible = 任意兼容 POST /audio/transcriptions 的服务
STT_PROVIDER="auto"
STT_BASE_URL=""
STT_API_KEY=""
STT_MODEL="whisper-1"